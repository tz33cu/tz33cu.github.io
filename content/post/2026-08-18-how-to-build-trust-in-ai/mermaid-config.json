{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "lineColor": "#59636e",
    "primaryTextColor": "#17212b",
    "tertiaryColor": "#fcfcfb",
    "background": "#fcfcfb",
    "clusterBkg": "#f8f9fa",
    "clusterBorder": "#7a858f"
  },
  "flowchart": {
    "curve": "linear",
    "htmlLabels": true,
    "nodeSpacing": 45,
    "rankSpacing": 55,
    "padding": 16,
    "useMaxWidth": true
  }
}
